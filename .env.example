# ─────────────────────────────────────────────────────────────
# Переменные окружения. Скопируйте файл в .env.local и заполните.
# Файл .env.local в репозиторий НЕ попадает (см. .gitignore).
# Секреты хранятся только здесь — никогда в коде и не во frontend.
# ─────────────────────────────────────────────────────────────

# ── Уведомления администратору в Telegram ────────────────────
# 1) Создайте бота у @BotFather и скопируйте токен.
# 2) Добавьте бота в чат администраторов и узнайте id чата
#    (например, через @getidsbot). У групп id начинается с минуса.
# Без этих двух переменных заявки всё равно сохраняются в папку /data.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── CRM (необязательно) ──────────────────────────────────────
# none — заявки только в /data и Telegram (по умолчанию)
# webhook — отправка JSON на ваш адрес (Make, n8n, самописный приёмник)
CRM_PROVIDER=none
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# ── Защита от спама: откуда брать IP клиента ────────────────
# Сколько прокси стоит перед приложением (nginx/Caddy = 1, Cloudflare + nginx = 2).
TRUST_PROXY_HOPS=1
# Если сайт стоит за Cloudflare — поставьте 1, тогда берётся CF-Connecting-IP.
TRUST_CLOUDFLARE=0

# ── Доступ к странице заявок /admin (когда будет подключена) ─
ADMIN_USER=admin
ADMIN_PASSWORD=
